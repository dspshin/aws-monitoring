# 이 파일을 .env로 복사한 후 값을 설정하세요.
# 이미 설정된 환경변수는 .env 값보다 우선합니다.

# 필수: Telegram 봇 토큰과 보고서를 받을 채팅 ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_chat_id_here

# 선택: 프로세스 이름에 포함될 검색어 (대소문자 무시, 미설정 시 NS)
PROCESS_FILTER=NS

# 선택: 보고서의 Alias에 표시할 서버 별칭
# 비워두거나 제거하면 Alias 줄은 생략됩니다. 실제 호스트명은 Name에 표시됩니다.
SERVER_NAME=production-seoul
